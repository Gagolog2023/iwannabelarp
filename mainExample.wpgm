import wollok.game.*

import example.pepita

program PepitaGame {
	game.title("Pepita")
	game.height(10)
	game.width(10)
    game.cellSize(50)
	// add assets in asset folder, for example, for the background
    // game.boardGround("fondo2.jpg")

	//

	// game.showAttributes(0) //Debug
	game.addVisual(tumama)
	game.start()
}

object tumama {
  var property position = game.at(5,5)
  method image() = "pepita.jpg"
}